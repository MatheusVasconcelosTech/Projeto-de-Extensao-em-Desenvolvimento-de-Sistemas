        // Quantidade considerada como estoque baixo
        const int limiteEstoque = 5;

        bool encontrou = false;

        foreach (Produto produto in produtos)
        {
            if (produto.Estoque <= limiteEstoque)
            {
                Console.WriteLine();
                Console.WriteLine(
                    "Produto: " +
                    produto.Nome
                );

                Console.WriteLine(
                    "Estoque: " +
                    produto.Estoque
