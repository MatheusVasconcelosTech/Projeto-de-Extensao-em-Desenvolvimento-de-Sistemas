            "===== CADASTRO DE SERVIÇO ====="
        );

        Console.Write("Nome do serviço: ");
        servico.Nome =
            Console.ReadLine();

        Console.Write("Descrição: ");
        servico.Descricao =
            Console.ReadLine();

        Console.Write("Preço: R$ ");

        double.TryParse(
            Console.ReadLine(),
            out servico.Preco
        );

        servicos.Add(servico);

        Console.WriteLine();
        Console.WriteLine(
            "Serviço cadastrado com sucesso!"
        );

        Console.ReadKey();
    }


    static void ListarServicos()
    {
        Console.Clear();

        Console.WriteLine(
            "===== SERVIÇOS CADASTRADOS ====="
        );

        if (servicos.Count == 0)
        {
            Console.WriteLine(
                "Nenhum serviço cadastrado."
            );
        }
        else
        {
            for (
                int i = 0;
                i < servicos.Count;
                i++)
            {
                Console.WriteLine();

                Console.WriteLine(
                    "Serviço " + (i + 1)
                );

                Console.WriteLine(
                    "Nome: " +
                    servicos[i].Nome
                );

                Console.WriteLine(
                    "Descrição: " +
                    servicos[i].Descricao
                );

                Console.WriteLine(
                    "Preço: R$ " +
                    servicos[i].Preco.ToString("F2")
                );
            }
        }

        Console.ReadKey();
    }


    // ====================================================
    // 8 - REAJUSTE DE PREÇOS
    // ====================================================

    static void ReajustarPrecos()
    {
        Console.Clear();

        Console.WriteLine(
            "===== REAJUSTE DE PREÇOS ====="
        );

        if (produtos.Count == 0)
        {
            Console.WriteLine(
                "Nenhum produto cadastrado."
            );

            Console.ReadKey();
            return;
        }

        Console.Write("Nome do produto: ");

        string nome =
            Console.ReadLine();

        Produto produtoEncontrado =
            null;

        foreach (Produto produto in produtos)
        {
            if (produto.Nome.Equals(
                nome,
                StringComparison.OrdinalIgnoreCase))
            {
                produtoEncontrado = produto;
                break;
            }
        }

        if (produtoEncontrado == null)
        {
            Console.WriteLine(
                "\nProduto não encontrado."
            );
        }
        else
        {
            Console.WriteLine();
            Console.WriteLine(
                "Preço atual: R$ " +
                produtoEncontrado.Preco.ToString("F2")
            );

            Console.Write(
                "Percentual de reajuste: "
            );

            double percentual;

            double.TryParse(
                Console.ReadLine(),
                out percentual
            );

            if (percentual <= 0)
            {
                Console.WriteLine(
                    "\nPercentual inválido."
                );
            }
            else
            {
                double precoAntigo =
                    produtoEncontrado.Preco;

                // Cálculo do novo preço
                double novoPreco =
                    precoAntigo +
                    (
                        precoAntigo *
                        percentual /
                        100
                    );

                produtoEncontrado.Preco =
                    novoPreco;

                Console.WriteLine();

                Console.WriteLine(
                    "Reajuste realizado com sucesso!"
                );

                Console.WriteLine(
                    "Preço anterior: R$ " +
                    precoAntigo.ToString("F2")
                );

                Console.WriteLine(
                    "Novo preço: R$ " +
                    novoPreco.ToString("F2")
                );
            }
        }

        Console.ReadKey();
    }
