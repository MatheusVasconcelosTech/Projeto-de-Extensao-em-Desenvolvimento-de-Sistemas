            Console.Write("Quantidade de entrada: ");

            int quantidade;

            int.TryParse(
                Console.ReadLine(),
                out quantidade
            );

            if (quantidade > 0)
            {
                produtoEncontrado.Estoque +=
                    quantidade;

                Console.WriteLine(
                    "\nEstoque atualizado!"
                );

                Console.WriteLine(
                    "Novo estoque: " +
                    produtoEncontrado.Estoque
                );
            }
            else
            {
                Console.WriteLine(
                    "\nQuantidade inválida."
                );
            }
        }

        Console.ReadKey();
    }


