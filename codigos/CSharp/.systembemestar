    static void RegistrarVenda()
    {
        Console.Clear();

        Console.WriteLine(
            "===== REGISTRO DE VENDA ====="
        );

        if (produtos.Count == 0)
        {
            Console.WriteLine(
                "Nenhum produto cadastrado."
            );

            Console.ReadKey();
            return;
        }

        Venda venda = new Venda();

        Console.Write("Cliente: ");
        venda.Cliente =
            Console.ReadLine();

        Console.Write("Produto: ");
        venda.Produto =
            Console.ReadLine();

        Console.Write("Quantidade: ");

        int.TryParse(
            Console.ReadLine(),
            out venda.Quantidade
        );

        Produto produtoEncontrado =
            null;

        foreach (Produto produto in produtos)
        {
            if (produto.Nome.Equals(
                venda.Produto,
                StringComparison.OrdinalIgnoreCase))
            {
                produtoEncontrado = produto;
                break;
            }
        }

        if (produtoEncontrado == null)
        {
            Console.WriteLine(
                "\nProduto não encontrado."
            );
        }
        else if (venda.Quantidade <= 0)
        {
            Console.WriteLine(
                "\nQuantidade inválida."
            );
        }
        else if (
            venda.Quantidade >
            produtoEncontrado.Estoque)
        {
            Console.WriteLine(
                "\nEstoque insuficiente."
            );
        }
        else
        {
            // Cálculo do valor da venda
            venda.Total =
                produtoEncontrado.Preco *
                venda.Quantidade;

            // Atualização automática do estoque
            produtoEncontrado.Estoque -=
                venda.Quantidade;

            vendas.Add(venda);

            Console.WriteLine();
            Console.WriteLine(
                "Venda registrada com sucesso!"
            );

            Console.WriteLine(
                "Valor total: R$ " +
                venda.Total.ToString("F2")
            );
        }

        Console.ReadKey();
    }


