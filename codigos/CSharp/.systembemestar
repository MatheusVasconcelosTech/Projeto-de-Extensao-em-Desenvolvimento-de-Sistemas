    static void NovoAgendamento()
    {
        Console.Clear();

        Agendamento agendamento =
            new Agendamento();

        Console.WriteLine(
            "===== NOVO AGENDAMENTO ====="
        );

        Console.Write("Cliente: ");
        agendamento.Cliente =
