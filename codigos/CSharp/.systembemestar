    static void EntradaEstoque()
    {
        Console.Clear();

        Console.WriteLine(
            "===== ENTRADA DE ESTOQUE ====="
        );

        Console.Write("Produto: ");
        string nome =
            Console.ReadLine();

        Produto produtoEncontrado =
            null;

        foreach (Produto produto in produtos)
        {
            if (produto.Nome.Equals(
                nome,
                StringComparison.OrdinalIgnoreCase))
