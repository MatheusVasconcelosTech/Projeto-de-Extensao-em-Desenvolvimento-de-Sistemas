            Console.ReadLine();

        bool horarioOcupado = false;

        foreach (
            Agendamento item
            in agendamentos)
        {
            if (
                item.Data ==
                agendamento.Data &&
                item.Horario ==
                agendamento.Horario)
            {
                horarioOcupado = true;
                break;
            }
        }

        if (horarioOcupado)
