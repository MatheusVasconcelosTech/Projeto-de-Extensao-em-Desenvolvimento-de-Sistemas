    static void RegistrarPedido()
    {
        Console.Clear();

        if (clientes.Count == 0 ||
            produtos.Count == 0)
        {
            Console.WriteLine(
                "É necessário possuir clientes " +
                "e produtos cadastrados."
            );

            Console.ReadKey();
            return;
        }

        Pedido pedido = new Pedido();

        Console.WriteLine("===== REGISTRO DE PEDIDO =====");

        Console.Write("Nome do cliente: ");
        pedido.Cliente = Console.ReadLine();

        Console.Write("Nome do produto: ");
        pedido.Produto = Console.ReadLine();

        Console.Write("Quantidade: ");

        int.TryParse(
            Console.ReadLine(),
            out pedido.Quantidade
        );

        Produto produtoEncontrado = null;

        foreach (Produto produto in produtos)
        {
            if (produto.Nome.Equals(
                pedido.Produto,
                StringComparison.OrdinalIgnoreCase))
            {
                produtoEncontrado = produto;
                break;
            }
        }

        if (produtoEncontrado == null)
        {
            Console.WriteLine(
                "\nProduto não encontrado."
            );
        }
        else if (pedido.Quantidade <= 0)
        {
            Console.WriteLine(
                "\nQuantidade inválida."
            );
        }
        else if (
            pedido.Quantidade >
            produtoEncontrado.Estoque)
        {
            Console.WriteLine(
                "\nEstoque insuficiente."
            );
        }
        else
        {
            pedido.Total =
                produtoEncontrado.Preco *
                pedido.Quantidade;

            produtoEncontrado.Estoque -=
                pedido.Quantidade;

            pedidos.Add(pedido);

            Console.WriteLine(
                "\nPedido registrado com sucesso!"
            );

            Console.WriteLine(
                "Total: R$ " +
                pedido.Total.ToString("F2")
            );
        }

        Console.ReadKey();
    }


