CREATE DATABASE bemestar_plus;

USE bemestar_plus;


-- TABELA USUARIO

CREATE TABLE usuario (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(120) NOT NULL,
    data_nascimento DATE,
    telefone VARCHAR(20),
    email VARCHAR(150) UNIQUE,
    senha_hash VARCHAR(255)
);


-- TABELA CUIDADOR

CREATE TABLE cuidador (
    id_cuidador INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(120) NOT NULL,
    telefone VARCHAR(20),
    email VARCHAR(150)
);


-- TABELA USUARIO_CUIDADOR

CREATE TABLE usuario_cuidador (
    id_usuario INT NOT NULL,
    id_cuidador INT NOT NULL,
    parentesco VARCHAR(50),

    PRIMARY KEY (id_usuario, id_cuidador),

    FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario),

    FOREIGN KEY (id_cuidador)
        REFERENCES cuidador(id_cuidador)
);


-- TABELA MEDICAMENTO

CREATE TABLE medicamento (
    id_medicamento INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(120) NOT NULL,
    principio_ativo VARCHAR(120),
    dosagem VARCHAR(50),
    forma_uso VARCHAR(50),
    fabricante VARCHAR(120)
);


-- TABELA USO_MEDICAMENTO

CREATE TABLE uso_medicamento (
    id_uso INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    id_medicamento INT NOT NULL,
    data_inicio DATE NOT NULL,
    data_fim DATE,
    frequencia VARCHAR(80),
    observacoes VARCHAR(255),

    FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario),

    FOREIGN KEY (id_medicamento)
        REFERENCES medicamento(id_medicamento)
);


-- TABELA HORARIO

CREATE TABLE horario (
    id_horario INT AUTO_INCREMENT PRIMARY KEY,
    id_uso INT NOT NULL,
    horario TIME NOT NULL,
    quantidade VARCHAR(50),

    FOREIGN KEY (id_uso)
        REFERENCES uso_medicamento(id_uso)
);


-- TABELA REGISTRO_TOMADA

CREATE TABLE registro_tomada (
    id_registro INT AUTO_INCREMENT PRIMARY KEY,
    id_horario INT NOT NULL,
    data_prevista DATETIME NOT NULL,
    data_real DATETIME,
    status VARCHAR(20) NOT NULL,

    FOREIGN KEY (id_horario)
        REFERENCES horario(id_horario)
);


-- TABELA NOTIFICACAO

CREATE TABLE notificacao (
    id_notificacao INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    id_registro INT,
    data_hora DATETIME NOT NULL,
    status VARCHAR(20) NOT NULL,

    FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario),

    FOREIGN KEY (id_registro)
        REFERENCES registro_tomada(id_registro)
);

